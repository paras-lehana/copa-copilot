# Copa Copilot — environment variables (names only; never commit real values).
# The whole app runs with ZERO keys: DEMO_MODE=true answers everything deterministically.

# ---- API (apps/api) ----
PORT=8080
# true = deterministic keyless assistant/briefings computed by @copa/core engines
DEMO_MODE=true
# Gemini API key (server-side only; in production mounted from Secret Manager `gemini-api-key`)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated CORS allow-list
ALLOWED_ORIGINS=http://localhost:3000
# Seed for the deterministic stadium simulation (any integer)
SIM_SEED=26

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
